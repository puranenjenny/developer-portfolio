---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = await getCollection('projects');
const learning = await getCollection('learning');
const labels = {
  completed: 'Completed',
  'in-progress': 'In progress',
  experiment: 'Experiment',
} as const;
---

<Base
  title="Developer portfolio (placeholder)"
  description="Placeholder homepage used to verify the build and preview pipeline."
>
  <p class="notice" role="note">
    Placeholder content only. The real portfolio content is not written yet.
  </p>
  <h1>Developer portfolio</h1>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul class="cards">
      {
        projects.map((p) => (
          <li class="card">
            <h3>{p.data.title}</h3>
            <p class="status" data-status={p.data.status}>
              {labels[p.data.status]}
            </p>
            <p>{p.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="learning-heading">
    <h2 id="learning-heading">Learning &amp; experiments</h2>
    <ul class="cards">
      {
        learning.map((l) => (
          <li class="card">
            <h3>{l.data.title}</h3>
            <p class="status" data-status={l.data.status}>
              {labels[l.data.status]}
            </p>
            <p>{l.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
