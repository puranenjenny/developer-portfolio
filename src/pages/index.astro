---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NfcFlow from '../components/NfcFlow.astro';
import { withBase } from '../utils/url';

const order = [
  'chatlog-analyzer',
  'git-github-student-guide',
  'penny-paladin',
  'r-autio-oy',
];
const projects = await getCollection('projects');
const featured = order.map((id) => projects.find((p) => p.id === id)!);
const nfc = projects.find((p) => p.id === 'nfc-cat-feeder')!;
const more = projects.filter(
  (p) => !order.includes(p.id) && p.id !== 'nfc-cat-feeder',
);
const learning = await getCollection('learning');

const labels = {
  completed: 'Completed',
  'in-progress': 'In progress',
  experiment: 'Experiment',
} as const;
---

<Base
  title="Jenny Puranen | Software developer"
  description="Jenny Puranen, a recently graduated ICT professional in Helsinki working with Python, web development, data, AI and automation."
>
  <section class="intro" aria-labelledby="intro-heading">
    <h1 id="intro-heading">Hi, I'm Jenny.</h1>
    <p>
      I'm a recently graduated ICT professional who likes building practical
      things with people in mind. My path started in arts and special-needs
      work, which is why accessibility and clear, friendly interfaces matter
      to me. These days I work with Python, web development, data, AI and
      automation, and I'm always experimenting with something new.
    </p>
  </section>

  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured projects</h2>
    <ul class="cards featured">
      {
        featured.map((p) => (
          <li class="card">
            {p.data.image && (
              <img
                src={withBase(p.data.image.src)}
                alt={p.data.image.alt}
                loading="lazy"
              />
            )}
            <h3>{p.data.title}</h3>
            <p class="status" data-status={p.data.status}>
              {labels[p.data.status]}
            </p>
            <p>{p.data.summary}</p>
            {p.data.role && (
              <p>
                <strong>My role:</strong> {p.data.role}
              </p>
            )}
            {p.data.collaborators.length > 0 && (
              <p>
                <strong>Team:</strong> {p.data.collaborators.join(', ')}
              </p>
            )}
            <p class="tech">{p.data.tech.join(' · ')}</p>
            {p.data.links.length > 0 && (
              <p class="links">
                {p.data.links.map((l) => (
                  <a href={l.url}>{l.label}</a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="automation-heading">
    <h2 id="automation-heading">Everyday automation</h2>
    <div class="card">
      <h3>{nfc.data.title}</h3>
      <p class="status" data-status={nfc.data.status}>
        {labels[nfc.data.status]}, in daily use
      </p>
      <p>{nfc.data.summary}</p>
      <p>
        Tapping the tag with my phone runs a Google Apps Script that writes
        the feeding time to a Google Sheet. Small, and I really use it.
      </p>
      <p class="tech">{nfc.data.tech.join(' · ')}</p>
      <NfcFlow />
    </div>
  </section>

  <section aria-labelledby="more-heading">
    <h2 id="more-heading">More projects</h2>
    <ul class="cards">
      {
        more.map((p) => (
          <li class="card">
            <h3>{p.data.title}</h3>
            <p class="status" data-status={p.data.status}>
              {labels[p.data.status]}
            </p>
            <p>{p.data.summary}</p>
            <p class="tech">{p.data.tech.join(' · ')}</p>
          </li>
        ))
      }
    </ul>
    <p>
      An experiment is a small prototype I built to try something out. It is
      not a finished product.
    </p>
  </section>

  <section aria-labelledby="learning-heading">
    <h2 id="learning-heading">Learning &amp; experiments</h2>
    <ul class="cards">
      {
        learning.map((l) => (
          <li class="card">
            <h3>{l.data.title}</h3>
            <p class="status" data-status={l.data.status}>
              {labels[l.data.status]}
            </p>
            <p>{l.data.summary}</p>
            <p class="tech">{l.data.topics.join(' · ')}</p>
            {l.data.links.length > 0 && (
              <p class="links">
                {l.data.links.map((x) => (
                  <a href={x.url}>{x.label}</a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <div class="skills">
      <div>
        <h3>Used in my projects</h3>
        <p>
          Python, pandas, Flask, MySQL, PHP, Kotlin, SQLite, HTML, CSS,
          JavaScript, Git and GitHub, Google Apps Script
        </p>
      </div>
      <div>
        <h3>Currently learning</h3>
        <p>AI development, AWS, Claude Code, automated testing</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact</h2>
    <p>Jenny Puranen, Helsinki, Finland</p>
    <ul class="plain">
      <li><a href="mailto:puranenjenny@gmail.com">puranenjenny@gmail.com</a></li>
      <li><a href="https://www.linkedin.com/in/jenny-puranen/">LinkedIn</a></li>
      <li><a href="https://github.com/puranenjenny">GitHub</a></li>
    </ul>
    <p>Languages: Finnish (native), English (C1)</p>
  </section>
</Base>
