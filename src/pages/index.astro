---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NfcFlow from '../components/NfcFlow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Gallery from '../components/Gallery.astro';

const projects = await getCollection('projects');
const pick = (ids: string[]) => ids.map((id) => projects.find((p) => p.id === id)!);

const featured = pick(['chatlog-analyzer', 'git-github-student-guide', 'r-autio-oy']);
const mobile = pick(['penny-paladin', 'scatterbrain', 'vegan-voyager-helsinki']);
const games = pick(['metsaseikkailu', 'zigzag', 'ar-jewelry-tryon']);
const more = pick(['luna-maria', 'botpress-chatbot', 'sixty-minute-challenge']);
const nfc = pick(['nfc-cat-feeder'])[0];
const learning = await getCollection('learning');

const labels = {
  completed: 'Completed',
  'in-progress': 'In progress',
  experiment: 'Experiment',
} as const;
---

<Base
  title="Jenny Puranen | Software developer"
  description="Jenny Puranen, a recently graduated ICT professional in Helsinki working with Python, web development, data, AI and automation."
>
  <section class="intro" aria-labelledby="intro-heading">
    <h1 id="intro-heading">Hi, I'm Jenny.</h1>
    <p>
      I'm a recently graduated ICT professional who likes building practical
      things with people in mind. My path started in arts and special-needs
      work, which is why accessibility and clear, friendly interfaces matter
      to me. These days I work with Python, web development, data, AI and
      automation, and I'm always experimenting with something new.
    </p>
    <ul class="contact-row plain" aria-label="Contact">
      <li><a class="btn" href="mailto:puranenjenny@gmail.com">Email me</a></li>
      <li><a class="btn ghost" href="https://www.linkedin.com/in/jenny-puranen/">LinkedIn</a></li>
      <li><a class="btn ghost" href="https://github.com/puranenjenny">GitHub</a></li>
    </ul>
  </section>

  <div id="projects">
  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured projects</h2>
    <ul class="cards two">{featured.map((p) => <ProjectCard entry={p} />)}</ul>
  </section>

  <section aria-labelledby="mobile-heading">
    <h2 id="mobile-heading">Mobile apps</h2>
    <ul class="cards three">{mobile.map((p) => <ProjectCard entry={p} />)}</ul>
  </section>

  <section aria-labelledby="games-heading">
    <h2 id="games-heading">Games &amp; interactive</h2>
    <ul class="cards three">{games.map((p) => <ProjectCard entry={p} />)}</ul>
  </section>

  <section aria-labelledby="more-heading">
    <h2 id="more-heading">Creative web, AI &amp; experiments</h2>
    <ul class="cards three">{more.map((p) => <ProjectCard entry={p} />)}</ul>
    <p>
      An experiment is a small prototype I built to try something out. It is
      not a finished product.
    </p>
  </section>

  <section aria-labelledby="automation-heading">
    <h2 id="automation-heading">Everyday automation</h2>
    <div class="card">
      <h3>{nfc.data.title}</h3>
      <p class="status" data-status={nfc.data.status}>
        {labels[nfc.data.status]}, in daily use
      </p>
      <p>{nfc.data.summary}</p>
      <p>
        Tapping the tag with my phone runs a Google Apps Script that writes
        the feeding time to a Google Sheet. Small, and I really use it.
      </p>
      <p class="tech">{nfc.data.tech.join(' · ')}</p>
      <NfcFlow />
    </div>
  </section>
  </div>

  <section id="learning" aria-labelledby="learning-heading">
    <h2 id="learning-heading">Learning &amp; experiments</h2>
    <ul class="cards two">
      {
        learning.map((l) => (
          <li class="card">
            {l.data.gallery && (
              <Gallery files={l.data.gallery.files} altPrefix={l.data.gallery.altPrefix} />
            )}
            <h3>{l.data.title}</h3>
            <p class="status" data-status={l.data.status}>
              {labels[l.data.status]}
              {l.data.progress && `, ${l.data.progress}`}
            </p>
            <p>{l.data.summary}</p>
            {l.data.courses.length > 0 && (
              <details>
                <summary>Courses</summary>
                <ul>
                  {l.data.courses.map((c) => (
                    <li>
                      {c.title} ({c.done ? 'done' : 'in progress'})
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <p class="tech">{l.data.topics.join(' · ')}</p>
            {l.data.links.length > 0 && (
              <p class="links">
                {l.data.links.map((x) => (
                  <a href={x.url}>{x.label}</a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <div class="skills">
      <div>
        <h3>Used in my projects</h3>
        <p>
          Python, pandas, Flask, MySQL, PHP, Kotlin, SQLite, Flutter, Dart,
          Unity, C#, HTML, CSS, JavaScript, Git and GitHub, Google Apps
          Script, Blender, Lens Studio
        </p>
      </div>
      <div>
        <h3>Currently learning</h3>
        <p>Azure and AI development, AWS, Claude Code, automated testing</p>
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Let's talk</h2>
    <p>Jenny Puranen, Helsinki, Finland. Languages: Finnish (native), English (C1).</p>
    <ul class="contact-row plain">
      <li><a class="btn" href="mailto:puranenjenny@gmail.com">puranenjenny@gmail.com</a></li>
      <li><a class="btn ghost" href="https://www.linkedin.com/in/jenny-puranen/">LinkedIn</a></li>
      <li><a class="btn ghost" href="https://github.com/puranenjenny">GitHub</a></li>
    </ul>
  </section>
</Base>
